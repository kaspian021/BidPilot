# ---------------------------------------------------------------------------
# Copy to .env  (cp .env.example .env)  and fill in.
# NEVER commit .env — it is gitignored.
# ---------------------------------------------------------------------------

# --- Telegram ---------------------------------------------------------------
# 1) open @BotFather -> /newbot -> copy the token
# 2) send any message to your bot, then run: bidpilot telegram-whoami
# 3) put the chat_id here (comma separated for several recipients)
TELEGRAM_BOT_TOKEN="123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TELEGRAM_CHAT_IDS="123456789"

# --- LLM (optional but strongly recommended) --------------------------------
# Leave empty to use the built-in Persian template instead.
LLM_API_KEY=""

# --- Parscoders session -----------------------------------------------------
# Log in to parscoders.com in your browser -> DevTools -> Application -> Cookies
# -> copy the PHPSESSID value (or the whole cookie header).
PARSOCODERS_COOKIE="PHPSESSID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Only used if sources.parscoders.settings.auth.mode == "credentials"
PARSOCODERS_USERNAME=""
PARSOCODERS_PASSWORD=""

# --- Optional overrides -----------------------------------------------------
# DATABASE_URL="postgresql+asyncpg://user:pass@localhost:5432/bidpilot"
