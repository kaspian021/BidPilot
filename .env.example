# ============================================================================
#  اختیاری — BidPilot هیچ مقدار اجباری از .env نمی‌خواهد
# ----------------------------------------------------------------------------
#  همه‌ی اطلاعات (توکن تلگرام، کلید هوش مصنوعی رایگان، حساب سایت، پروفایل و لحن)
#  با یکی از این دو راه وارد می‌شود:
#
#     bidpilot setup        ← ویزارد تعاملی در ترمینال (بدون ادیتور)
#     bidpilot bot          ← همه‌چیز از داخل خود تلگرام
#
#  و در فایل امنِ data/settings.json ذخیره می‌شود (chmod 600، در .gitignore).
#  مقادیر این فایل فقط برای Docker/CI یا مهاجرت از نسخه‌های قبلی است و
#  اولویت کمتری از data/settings.json دارد.
#
#  برای تست کامل بدون هیچ حساب واقعی:
#     bidpilot demo
# ============================================================================

# --- Telegram ---------------------------------------------------------------
# با «bidpilot setup» خودکار پر می‌شود؛ این‌جا لازم نیست.
# TELEGRAM_BOT_TOKEN="123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TELEGRAM_CHAT_IDS="123456789"

# --- LLM رایگان (کلید ماندگار) ---------------------------------------------
# پیشنهاد: Groq (https://console.groq.com/keys) — رایگان، بدون انقضا.
# جایگزین‌ها: Gemini / OpenRouter / Mistral / Ollama
# (انتخاب provider و مدل از setup/ربات انجام می‌شود؛ کلید در data/settings.json می‌ماند)
# LLM_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- حساب سایت فریلنسری -----------------------------------------------------
# روش ۱ (ساده‌تر و مطمئن‌تر): کوکی نشست بعد از لاگین در مرورگر
# PARSOCODERS_COOKIE="PHPSESSID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# روش ۲: نام کاربری و رمز — ربات خودش لاگین می‌کند
# PARSOCODERS_USERNAME=""
# PARSOCODERS_PASSWORD=""

# --- زیرساخت (اختیاری) ------------------------------------------------------
# DATABASE_URL="postgresql+asyncpg://user:pass@localhost:5432/bidpilot"
# برای نگه‌داشتن تنظیمات در مسیر دیگر:
# BIDPILOT_SETTINGS_FILE="/path/to/settings.json"
